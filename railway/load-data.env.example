# Variaveis para carregar os CSVs no banco analitico HospitalDB.
# Se rodar localmente, use o TCP Proxy do Railway para HOST/PORT.
# O script tambem aceita os nomes HOST, PORT, DATABASE, USER_DB e PASSWORD_DB.

MYSQLHOST=${{HospitalDB.MYSQLHOST}}
MYSQLPORT=${{HospitalDB.MYSQLPORT}}
MYSQLDATABASE=${{HospitalDB.MYSQLDATABASE}}
MYSQLUSER=${{HospitalDB.MYSQLUSER}}
MYSQLPASSWORD=${{HospitalDB.MYSQLPASSWORD}}
